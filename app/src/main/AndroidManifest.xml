<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sin permiso INTERNET a propósito: ningún dato sale del dispositivo. -->

    <!-- Solo para avisar de que está el resumen del mes. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Para saber cuál es el launcher y quitar la pantalla de bloqueo al salir a Inicio. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".TouchGrassApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TouchGrass">

        <!-- Fuera de Recientes: si no hay tarjeta que deslizar, HyperOS/MIUI no mata el
             proceso del servicio al limpiar Recientes (y Android no lo volvería a arrancar). -->
        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.TouchGrass.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Proceso propio: HyperOS/MIUI matan el proceso de la app al quitarla de recientes,
             y el servicio debe sobrevivir aunque la interfaz esté cerrada. -->
        <service
            android:name=".service.TouchGrassAccessibilityService"
            android:exported="false"
            android:process=":blocker"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Alarma del día 1 para avisar del resumen del mes. -->
        <receiver
            android:name=".notification.MonthlyReportReceiver"
            android:exported="false" />

    </application>

</manifest>

{
  "version": 2,
  "packageName": "com.zhiliaoapp.musically",
  "name": "TikTok",
  "blocks": "Para ti y Comunidad",
  "rules": [
    {
      "id": "for_you_tab",
      "description": "Pestaña Para ti",
      "match": {
        "allOf": [{ "viewId": "android:id/text1", "selected": true, "text": ["Para ti", "For You"] }]
      },
      "action": { "type": "click", "text": ["Mensajes", "Bandeja de entrada", "Inbox"] }
    },
    {
      "id": "community_tab",
      "description": "Pestaña Comunidad",
      "match": {
        "allOf": [{ "viewId": "android:id/text1", "selected": true, "text": ["Comunidad"] }]
      },
      "action": { "type": "click", "text": ["Mensajes", "Bandeja de entrada", "Inbox"] }
    }
  ]
}

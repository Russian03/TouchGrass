{
  "version": 14,
  "packageName": "com.instagram.android",
  "name": "Instagram",
  "blocks": "Reels",
  "places": [
    { "id": "chat", "match": { "allOf": [{ "viewId": "thread_fragment_container" }] } },
    { "id": "saved", "match": { "allOf": [{ "viewId": "saved_view_pager" }] } },
    { "id": "profile", "match": { "allOf": [{ "viewId": "profile_viewpager" }] } },
    {
      "id": "explore",
      "match": { "allOf": [{ "viewId": "search_tab", "selected": true }, { "viewId": "grid_card_layout_container" }] }
    },
    { "id": "feed", "match": { "allOf": [{ "viewId": "feed_tab", "selected": true }] } },
    { "id": "inbox", "match": { "allOf": [{ "viewId": "direct_tab", "selected": true }] } }
  ],
  "rules": [
    {
      "id": "reels_tab",
      "description": "Pestaña de Reels",
      "match": {
        "allOf": [{ "viewId": "clips_tab", "selected": true }]
      },
      "action": { "type": "click", "target": "feed_tab" },
      "coveredBy": { "allOf": [{ "viewId": "bottom_sheet_container" }] }
    },
    {
      "id": "reels_viewer",
      "description": "Visor de Reels y posts (Explorar, sugeridos)",
      "match": {
        "allOf": [{ "viewId": "clips_viewer_view_pager" }]
      },
      "action": { "type": "back" },
      "pager": "clips_viewer_view_pager",
      "coveredBy": { "allOf": [{ "viewId": "bottom_sheet_container" }] },
      "allowFrom": [
        { "place": "profile" },
        { "place": "chat", "untilScroll": true },
        { "place": "feed", "untilScroll": true },
        { "place": "saved", "untilScroll": true }
      ]
    },
    {
      "id": "explore_peek",
      "description": "Vista previa al mantener pulsado en Buscar",
      "match": {
        "allOf": [{ "viewId": "search_tab", "selected": true }, { "viewId": "media_group" }]
      },
      "action": { "type": "back" },
      "silentBack": true,
      "allowFrom": [{ "place": "profile" }, { "place": "saved" }]
    },
    {
      "id": "explore_menu",
      "description": "Menú contextual que queda tras soltar la vista previa de Buscar (solo si se viene de Buscar)",
      "match": {
        "allOf": [{ "viewId": "context_menu_options_list" }]
      },
      "action": { "type": "back" },
      "silentBack": true,
      "allowFrom": [
        { "place": "profile" },
        { "place": "saved" },
        { "place": "chat" },
        { "place": "feed" },
        { "place": "inbox" }
      ]
    },
    {
      "id": "feed_suggested",
      "description": "Posts de Inicio de gente que no sigues (se tapan uno a uno)",
      "match": {
        "allOf": [{ "viewId": "feed_tab", "selected": true }, { "viewId": "android:id/list" }],
        "noneOf": [{ "viewId": "clips_viewer_view_pager" }, { "viewId": "profile_viewpager" }]
      },
      "action": { "type": "click", "target": "feed_tab" },
      "mask": { "list": "android:id/list", "header": "row_feed_profile_header", "anchor": "inline_follow_button" }
    }
  ]
}

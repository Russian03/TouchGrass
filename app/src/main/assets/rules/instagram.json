{
  "version": 3,
  "packageName": "com.instagram.android",
  "rules": [
    {
      "id": "reels_tab",
      "description": "Pestaña de Reels",
      "match": {
        "allOf": [{ "viewId": "clips_tab", "selected": true }]
      },
      "action": { "type": "click", "target": "feed_tab" }
    },
    {
      "id": "reels_viewer",
      "description": "Visor de Reels (Explorar, feed, sugeridos)",
      "match": {
        "allOf": [{ "viewId": "clips_viewer_view_pager" }],
        "noneOf": [{ "viewId": "sender_profile_pic" }]
      },
      "action": { "type": "back" }
    },
    {
      "id": "explore_grid",
      "description": "Cuadrícula de Explorar",
      "match": {
        "allOf": [
          { "viewId": "search_tab", "selected": true },
          { "viewId": "grid_card_layout_container" }
        ]
      },
      "action": { "type": "cover", "target": "recycler_view", "below": "explore_action_bar" }
    }
  ]
}

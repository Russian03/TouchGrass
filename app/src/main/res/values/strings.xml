<resources>
    <string name="app_name" translatable="false">TouchGrass</string>
    <string name="home_title">Céntrate en el mundo que te rodea.</string>
    <string name="home_tagline">Usa tus apps sin perderte en el scroll infinito. Cada visita, una decisión consciente.</string>

    <string name="accessibility_service_label">TouchGrass: bloqueo del scroll</string>
    <string name="accessibility_service_description">TouchGrass usa este servicio para detectar cuándo entras en el scroll de una app (ahora, los Reels de Instagram y Para ti y Comunidad de TikTok) y taparlo con una pantalla de pausa, que también silencia el sonido. Solo observa las apps que bloquea (ahora, Instagram y TikTok) y solo lee los identificadores de los botones de la interfaz y el nombre de algunas pestañas (como «Para ti»): nunca lee tus mensajes, publicaciones ni nombres. De la pantalla de inicio solo detecta que has vuelto a ella, para quitar la pausa enseguida. Nada sale de tu móvil.</string>
    <string name="block_title">No hay\nscroll.</string>
    <string name="block_subtitle">Para y respira.</string>
    <string name="block_dismiss">Volver atrás</string>
    <string name="block_open_app">Pedir tiempo de uso</string>


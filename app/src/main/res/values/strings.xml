    <string name="onboarding_welcome_title">Bienvenido a TouchGrass</string>
    <string name="onboarding_welcome_body">Sigue usando tus apps para lo que importa: mensajes, amigos e historias. Sin perderte en el scroll.</string>
    <string name="onboarding_how_title">Cómo funciona</string>
    <string name="onboarding_how_block_title">El scroll, bloqueado</string>
    <string name="onboarding_how_block_body">Cuando entras en el scroll (por ejemplo, los Reels) aparece una pausa encima. El resto de la app funciona igual.</string>
    <string name="onboarding_how_budget_title">Un saldo diario</string>
    <string name="onboarding_how_budget_body">Cada día, a las 8:00, tienes unos minutos para desbloquear el scroll. Lo que no gastas no se acumula.</string>
    <string name="onboarding_how_unlock_title">Tú decides cuándo</string>
    <string name="onboarding_how_unlock_body">Pide los minutos que quieras desde la app. Corren desde ese momento y, al acabar, vuelve el bloqueo.</string>
    <string name="onboarding_disclosure_title">Antes de activarlo</string>
    <string name="onboarding_disclosure_intro">TouchGrass necesita el servicio de accesibilidad de Android para saber cuándo estás en el scroll.</string>
    <string name="onboarding_disclosure_reads_title">Qué mira</string>
    <string name="onboarding_disclosure_reads_body">Solo los identificadores de los botones de las apps que bloquea, ahora Instagram y TikTok (por ejemplo, «pestaña de Reels» o la pestaña «Para ti»), y si has vuelto a la pantalla de inicio.</string>
    <string name="onboarding_disclosure_never_title">Qué nunca lee</string>
    <string name="onboarding_disclosure_never_body">Tus mensajes, publicaciones, nombres, contraseñas ni nada de otras apps.</string>
    <string name="onboarding_disclosure_local_title">Nada sale del móvil</string>
    <string name="onboarding_disclosure_local_body">La app no tiene permiso de Internet. Tu límite y tu uso se guardan solo en este dispositivo, sin copias en la nube.</string>
    <string name="onboarding_disclosure_accept">Entendido</string>
    <string name="onboarding_limit_title">¿Cuántos minutos al día?</string>
    <string name="onboarding_limit_body">Es tu límite para este mes: los minutos que podrás desbloquear cada día.</string>
    <string name="onboarding_limit_note">Podrás bajarlo cuando quieras. Para subirlo tendrás que esperar al mes siguiente.</string>
    <string name="onboarding_limit_save">Guardar y seguir</string>
    <string name="onboarding_activate_title">Activa la protección</string>
    <string name="onboarding_activate_body">Busca TouchGrass en la lista de Accesibilidad y actívalo. Después vuelve aquí.</string>
    <string name="onboarding_restricted_hint">¿No te deja activarlo? En Android 13 o superior, abre los ajustes de la app, pulsa ⋮ y elige «Permitir ajustes restringidos».</string>
    <string name="onboarding_finish">Ir a TouchGrass</string>
    <string name="onboarding_finish_later">Lo haré más tarde</string>


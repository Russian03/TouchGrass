<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9">

    <!-- Contenido principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="80dp"
            android:paddingBottom="120dp">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Digital Boundaries"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#1A1C1C"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tailor your focus by managing how you interact with social platforms."
                android:textSize="14sp"
                android:textColor="#6F7A6B"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="32dp" />

            <!-- Instagram Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Header card — sin switch -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="24dp">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="16dp"
                            android:src="@drawable/ic_instagram"
                            android:scaleType="fitCenter" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Instagram"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#1A1C1C" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SOCIAL MEDIA"
                                android:textSize="10sp"
                                android:textColor="#6F7A6B"
                                android:letterSpacing="0.1" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Separador -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginBottom="20dp" />

                    <!-- Toggle Put a daily limit -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Put a daily limit"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#1A1C1C" />

                            <TextView
                                android:id="@+id/tvHideAlwaysDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Without this option Reels tab will never appear"
                                android:textSize="12sp"
                                android:textColor="#6F7A6B" />

                        </LinearLayout>

                        <Switch
                            android:id="@+id/switchHideAlways"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:showText="false"
                            android:track="@drawable/switch_track"
                            android:thumb="@drawable/switch_thumb" />

                    </LinearLayout>

                    <!-- Slider section — visible solo cuando switch ON -->
                    <LinearLayout
                        android:id="@+id/layoutSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="DAILY LIMIT"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#6F7A6B"
                                android:letterSpacing="0.1" />

                            <TextView
                                android:id="@+id/tvSliderValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="30"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="#006E1C" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" min/day"
                                android:textSize="13sp"
                                android:textColor="#6F7A6B" />

                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/seekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="115"
                            android:progress="25"
                            android:progressTint="#006E1C"
                            android:thumbTint="#006E1C"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="5 MIN"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="#BECAB9"
                                android:letterSpacing="0.1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2 HOURS"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="#BECAB9"
                                android:letterSpacing="0.1" />

                        </LinearLayout>

                        <!-- Descripción cuando slider visible -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="All videos will be limited past this time"
                            android:textSize="12sp"
                            android:textColor="#6F7A6B"
                            android:fontFamily="sans-serif"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Sección debug -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TODAY'S USAGE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#6F7A6B"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Time remaining"
                            android:textSize="14sp"
                            android:textColor="#3F4A3C" />

                        <TextView
                            android:id="@+id/tvRemainingTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--:--"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#006E1C" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧪 TEST — Simulate usage"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#6F7A6B"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="8dp" />

                    <SeekBar
                        android:id="@+id/seekBarDebug"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="#856404"
                        android:thumbTint="#856404"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvDebugValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Used: 0%"
                        android:textSize="12sp"
                        android:textColor="#856404"
                        android:layout_marginBottom="12dp" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFF3CD">

                        <TextView
                            android:id="@+id/btnApplyDebug"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="Apply test value"
                            android:textColor="#856404"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="?attr/selectableItemBackground" />

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

    <!-- Top Bar fijo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:background="#F9F9F9"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="#006E1C" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#006E1C" />

    </LinearLayout>

    <!-- Botón guardar fijo abajo -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#006E1C">

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save Changes"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:background="?attr/selectableItemBackground" />

    </androidx.cardview.widget.CardView>

    <!-- Popup de confirmación -->
    <FrameLayout
        android:id="@+id/popupOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#44000000"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:id="@+id/popupCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="16dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp"
                android:gravity="center">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_logo"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Changes saved"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1A1C1C"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your new settings will take effect&#10;tomorrow at 8:00 AM."
                    android:textSize="14sp"
                    android:textColor="#6F7A6B"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginBottom="24dp" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:background="#E2E2E2"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </FrameLayout>

</FrameLayout>
<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9">

    <!-- Fondo borroso con el logo como textura -->
    <ImageView
        android:id="@+id/bgLogo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ic_logo"
        android:scaleType="centerCrop"
        android:alpha="0.08" />

    <!-- Capa glassmorphism -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#99FFFFFF"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <!-- Contenido central -->
        <LinearLayout
            android:id="@+id/centerContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:alpha="0">

            <!-- Logo container -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="48dp">

                <!-- Glow suave detrás -->
                <View
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:background="@drawable/glow_circle" />

                <!-- Card con logo -->
                <androidx.cardview.widget.CardView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    xmlns:app="http://schemas.android.com/apk/res-auto">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_logo"
                        android:scaleType="fitCenter" />

                </androidx.cardview.widget.CardView>

            </FrameLayout>

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your digital detox\nis active."
                android:textSize="36sp"
                android:textColor="#1A1C1C"
                android:textStyle="normal"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:lineSpacingMultiplier="1.1"
                android:layout_marginBottom="24dp" />

            <!-- Separador con texto -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="48dp">

                <View
                    android:layout_width="32dp"
                    android:layout_height="1dp"
                    android:background="#30000000" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Take a deep breath before returning."
                    android:textSize="13sp"
                    android:textColor="#6F7A6B"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center" />

                <View
                    android:layout_width="32dp"
                    android:layout_height="1dp"
                    android:background="#30000000" />

            </LinearLayout>

            <!-- Indicador de pulso -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/dot_primary"
                    android:layout_marginEnd="4dp" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/dot_secondary"
                    android:layout_marginEnd="4dp" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/dot_tertiary" />

            </LinearLayout>

        </LinearLayout>

        <!-- Botones — aparecen a los 5 segundos -->
        <LinearLayout
            android:id="@+id/buttonsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingBottom="64dp"
            android:alpha="0"
            android:visibility="invisible">

            <!-- Exit Focus -->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#26000000"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:id="@+id/btnExitFocus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✕"
                        android:textSize="14sp"
                        android:textColor="#3F4A3C"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Exit Focus"
                        android:textSize="14sp"
                        android:textColor="#3F4A3C"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.02" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Exit to Menu -->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#26000000"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:id="@+id/btnExitToMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⌂"
                        android:textSize="14sp"
                        android:textColor="#3F4A3C"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Exit to Menu"
                        android:textSize="14sp"
                        android:textColor="#3F4A3C"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.02" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
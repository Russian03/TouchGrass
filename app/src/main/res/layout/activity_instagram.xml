<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_alignParentTop="true"
        android:indeterminate="true"
        android:visibility="gone"
        android:progressTint="#E1306C" />

    <View
        android:id="@+id/touchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@android:color/transparent" />

    <FrameLayout
        android:id="@+id/dmOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">
    </FrameLayout>

    <FrameLayout
        android:id="@+id/fabWrapper"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="120dp"
        android:layout_marginEnd="16dp"
        android:elevation="12dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Burbuja blanca — se expande a la izquierda -->
        <LinearLayout
            android:id="@+id/fabBubble"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center_vertical|end"
            android:gravity="center_vertical"
            android:paddingEnd="68dp"
            android:paddingStart="16dp"
            android:orientation="horizontal"
            android:visibility="invisible">

            <TextView
                android:id="@+id/fabText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

        </LinearLayout>

        <!-- Logo — siempre en el lado derecho -->
        <ImageView
            android:id="@+id/fabLogo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="end|center_vertical"
            android:src="@drawable/ic_logo"
            android:scaleType="fitCenter"
            android:padding="6dp" />

    </FrameLayout>

</RelativeLayout>